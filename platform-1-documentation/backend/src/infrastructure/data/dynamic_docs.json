      "borderRadius": 8
    },
    "renderModes": {
      "web": {
        "policy": "CUSTOMIZABLE",
        "layoutType": "STRUCTURED_FLOW",
        "showSidebarNav": true,
        "collapsibleSections": true,
        "enableInteractiveTesting": true
      },
      "print_a4": {
        "policy": "RESTRICTED",
