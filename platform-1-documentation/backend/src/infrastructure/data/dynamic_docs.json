        "orientation": "portrait",
        "marginsMm": {
          "top": 20,
          "bottom": 20,
          "left": 15,
          "right": 15
        },
        "headerText": "البنك المركزي - معيار التحويلات المالية v1.0",
        "footerText": "سري للغاية - للاستخدام الداخلي والمصارف المعتمدة فقط",
        "showPageNumbers": true,
        "repeatTableHeaders": true,
        "showOfficialWatermark": true
      }
    },
    "sections": [
      {
        "id": "sec-head",
        "type": "header",
        "title": "ترويسة الوثيقة",
        "data": {
          "title": "معيار واجهات التحويلات المالية اللحظية (IPS Engine)",
          "subtitle": "الدليل المرجعي الموحد للمصارف الشريكة ومقدمي خدمات الدفع (PSPs)",
          "description": "توضح هذه الوثيقة المعمارية معايير التكامل الفني والأمني لتنفيذ واستعلام التحويلات اللحظية وفق ضوابط الحوكمة الصارمة."
        }
      },
      {
        "id": "sec-callout-security",
        "type": "callout",
        "title": "تنبيه أمني إلزامي",
        "data": {
          "calloutType": "warning",
          "content": "يجب تشفير جميع حمولات التحويل باستخدام مفاتيح mTLS 1.3 مع توقيع الـ Payload بخوارزمية SHA-256 RSA قبل إرسال الطلب."
        }
      },
      {
        "id": "sec-ep-transfer",
        "type": "endpoint",
        "title": "نقطة نهاية: تنفيذ تحويل فوري",
        "data": {
          "method": "POST",
          "path": "/api/v1/transfers/instant",
          "description": "إرسال أمر تحويل مالي لحظي بين حسابين مصرفيين محليين.",
          "headers": [
            {
              "name": "Authorization",
              "type": "string",
              "required": true,
              "description": "Bearer JWT Token للمؤسسة الطالبة"
            },
            {
              "name": "X-Idempotency-Key",
              "type": "string",
              "required": true,
              "description": "معرف تفرد الطلب لمنع تكرار التحويل",
              "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
            },
            {
              "name": "X-Signature",
              "type": "string",
              "required": true,
              "description": "التوقيع الرقمي للـ Payload"
            }
          ],
          "parameters": [
            {
              "name": "validateOnly",
              "type": "boolean",
              "required": false,
              "description": "إجراء تدقيق وصحة أرصدة دون تنفيذ الخصم الفعلي"
            }
          ],
          "requestBody": "{\n  \"sourceAccount\": \"SA4420000001234567890123\",\n  \"destinationIban\": \"SA5530000009876543210987\",\n  \"beneficiaryName\": \"شركة الابتكار المالي المحدودة\",\n  \"amount\": 1500.5,\n  \"currency\": \"SAR\",\n  \"purposeCode\": \"SUPPLIER_PAYMENT\"\n}",
          "responseBody": "{\n  \"transactionId\": \"TX-99827361\",\n  \"status\": \"SETTLED\",\n  \"settledAt\": \"2026-10-16T14:30:00Z\",\n  \"referenceNumber\": \"REF-20261016-0012\",\n  \"fees\": 0\n}"
        }
      },
      {
        "id": "sec-table-fields",
        "type": "fields-table",
        "title": "قاموس الحقول والبيانات",
        "data": {
          "description": "مواصفات وتوصيف حقول الطلب والاستجابة مع قواعد التدقيق.",
          "parameters": [
            {
              "name": "sourceAccount",
              "type": "IBAN String (24 chars)",
              "required": true,
              "description": "رقم الآيبان للحساب المحول منه"
            },
            {
              "name": "destinationIban",
              "type": "IBAN String (24 chars)",
              "required": true,
              "description": "رقم الآيبان للحساب المستفيد"
            },
            {
              "name": "amount",
              "type": "Decimal(18,2)",
              "required": true,
              "description": "المبلغ الإجمالي بالعملة المحلية (حد أقصى 50,000 ريال)"
            },
            {
              "name": "purposeCode",
              "type": "Enum String",
              "required": true,
              "description": "رمز الغرض من التحويل وفق معيار ISO 20022"
            }
          ]
        }
      }
    ],
    "history": [
